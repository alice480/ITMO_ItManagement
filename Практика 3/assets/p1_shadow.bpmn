<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p1_shadow_Definitions" targetNamespace="urn:lamoda:cto:scenario-review:2026">
  <bpmn:collaboration id="p1_shadow_Collaboration">
    <bpmn:participant id="p1_shadow_Pool" name="Lamoda" processRef="p1_shadow_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="p1_shadow_Process" name="P1.A · Изолированная приёмка агента после восстановления" isExecutable="false">
    <bpmn:laneSet id="p1_shadow_LaneSet">
      <bpmn:lane id="p1_shadow_Lane0" name="Incident Commander">
        <bpmn:flowNodeRef>p1_shadow_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_endmissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_admit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_endyes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_shadow_Lane1" name="Реестр / платформа">
        <bpmn:flowNodeRef>p1_shadow_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_full</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_shadow_Lane2" name="Агент сопровождения">
        <bpmn:flowNodeRef>p1_shadow_abstain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_shadow_Lane3" name="SRE / независимый проверяющий">
        <bpmn:flowNodeRef>p1_shadow_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_shadow_Lane4" name="CTO / владелец агента">
        <bpmn:flowNodeRef>p1_shadow_disable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_shadow_endno</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_shadow_start" name="Инцидент закрыт">
      <bpmn:outgoing>p1_shadow_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p1_shadow_case" name="A1 Зафиксировать эталон и два журнала">
      <bpmn:incoming>p1_shadow_F0</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p1_shadow_read" name="A2 Проверить доступность доказательств">
      <bpmn:incoming>p1_shadow_F1</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_shadow_full" name="Контекст достаточен?">
      <bpmn:incoming>p1_shadow_F2</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F3</bpmn:outgoing>
      <bpmn:outgoing>p1_shadow_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p1_shadow_abstain" name="A3 Вернуть «нет оснований» со списком пробелов">
      <bpmn:incoming>p1_shadow_F3</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p1_shadow_endmissing" name="Кейс исключён из автодиагноза">
      <bpmn:incoming>p1_shadow_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p1_shadow_draft" name="A4 Подготовить черновик со ссылками">
      <bpmn:incoming>p1_shadow_F5</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p1_shadow_review" name="A5 Проверить качество и полную стоимость">
      <bpmn:incoming>p1_shadow_F6</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p1_shadow_gate" name="Все критерии выполнены?">
      <bpmn:incoming>p1_shadow_F7</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F8</bpmn:outgoing>
      <bpmn:outgoing>p1_shadow_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_shadow_disable" name="A6 Сохранить shadow или отключить">
      <bpmn:incoming>p1_shadow_F8</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_shadow_endno" name="В оперативном runbook агента нет">
      <bpmn:incoming>p1_shadow_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p1_shadow_admit" name="A7 Рассмотреть допуск только после drill">
      <bpmn:incoming>p1_shadow_F10</bpmn:incoming>
      <bpmn:outgoing>p1_shadow_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_shadow_endyes" name="Допуск не автоматический; решение CTO и IC">
      <bpmn:incoming>p1_shadow_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_shadow_F0" sourceRef="p1_shadow_start" targetRef="p1_shadow_case"/>
    <bpmn:sequenceFlow id="p1_shadow_F1" sourceRef="p1_shadow_case" targetRef="p1_shadow_read"/>
    <bpmn:sequenceFlow id="p1_shadow_F2" sourceRef="p1_shadow_read" targetRef="p1_shadow_full"/>
    <bpmn:sequenceFlow id="p1_shadow_F3" sourceRef="p1_shadow_full" targetRef="p1_shadow_abstain" name="Нет"/>
    <bpmn:sequenceFlow id="p1_shadow_F4" sourceRef="p1_shadow_abstain" targetRef="p1_shadow_endmissing"/>
    <bpmn:sequenceFlow id="p1_shadow_F5" sourceRef="p1_shadow_full" targetRef="p1_shadow_draft" name="Да"/>
    <bpmn:sequenceFlow id="p1_shadow_F6" sourceRef="p1_shadow_draft" targetRef="p1_shadow_review"/>
    <bpmn:sequenceFlow id="p1_shadow_F7" sourceRef="p1_shadow_review" targetRef="p1_shadow_gate"/>
    <bpmn:sequenceFlow id="p1_shadow_F8" sourceRef="p1_shadow_gate" targetRef="p1_shadow_disable" name="Нет"/>
    <bpmn:sequenceFlow id="p1_shadow_F9" sourceRef="p1_shadow_disable" targetRef="p1_shadow_endno"/>
    <bpmn:sequenceFlow id="p1_shadow_F10" sourceRef="p1_shadow_gate" targetRef="p1_shadow_admit" name="Да"/>
    <bpmn:sequenceFlow id="p1_shadow_F11" sourceRef="p1_shadow_admit" targetRef="p1_shadow_endyes"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p1_shadow_Diagram">
