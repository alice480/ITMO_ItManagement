<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p1_tobe_Definitions" targetNamespace="urn:lamoda:cto:scenario-review:2026">
  <bpmn:collaboration id="p1_tobe_Collaboration">
    <bpmn:participant id="p1_tobe_Pool" name="Lamoda" processRef="p1_tobe_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="p1_tobe_Process" name="P1 · TO-BE · Выпуск с общим реестром; инцидент без агента" isExecutable="false">
    <bpmn:laneSet id="p1_tobe_LaneSet">
      <bpmn:lane id="p1_tobe_Lane0" name="Продукт / Release owner">
        <bpmn:flowNodeRef>p1_tobe_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_endblock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_endok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_tobe_Lane1" name="Разработка / QA / CI">
        <bpmn:flowNodeRef>p1_tobe_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_registry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_tobe_Lane2" name="Агент сопровождения"/>
      <bpmn:lane id="p1_tobe_Lane3" name="SRE / дежурный инженер">
        <bpmn:flowNodeRef>p1_tobe_canary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_recover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_tobe_Lane4" name="Incident Commander / Operations">
        <bpmn:flowNodeRef>p1_tobe_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_tobe_endbad</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_tobe_start" name="Изменение готово">
      <bpmn:outgoing>p1_tobe_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p1_tobe_scope" name="P1.1 Согласовать объём и условия выпуска">
      <bpmn:incoming>p1_tobe_F0</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_tobe_build" name="P1.2 Выполнить CI и контрактные тесты">
      <bpmn:incoming>p1_tobe_F1</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p1_tobe_registry" name="P1.N1 Объединить сведения обоих журналов">
      <bpmn:incoming>p1_tobe_F2</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_tobe_complete" name="Доказательства полны?">
      <bpmn:incoming>p1_tobe_F3</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F4</bpmn:outgoing>
      <bpmn:outgoing>p1_tobe_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_tobe_block" name="P1.N2 Блокировать расширение canary">
      <bpmn:incoming>p1_tobe_F4</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_tobe_endblock" name="Доработка пакета; prod не расширен">
      <bpmn:incoming>p1_tobe_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p1_tobe_canary" name="P1.4 Выпустить и наблюдать canary">
      <bpmn:incoming>p1_tobe_F6</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p1_tobe_failure" name="Есть инцидент?">
      <bpmn:incoming>p1_tobe_F7</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F8</bpmn:outgoing>
      <bpmn:outgoing>p1_tobe_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_tobe_accept" name="P1.5 Принять новый маршрут заказов">
      <bpmn:incoming>p1_tobe_F8</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_tobe_endok" name="Маршрут принят">
      <bpmn:incoming>p1_tobe_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p1_tobe_manual" name="P1.8 Разобрать инцидент по реестру и логам">
      <bpmn:incoming>p1_tobe_F10</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_tobe_decision" name="P1.9 Утвердить действие без ответа агента">
      <bpmn:incoming>p1_tobe_F11</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_tobe_recover" name="P1.10 Восстановить и сверить заказы">
      <bpmn:incoming>p1_tobe_F12</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_tobe_archive" name="P1.N3 Сохранить эталон и трудозатраты">
      <bpmn:incoming>p1_tobe_F13</bpmn:incoming>
      <bpmn:outgoing>p1_tobe_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_tobe_endbad" name="Сервис восстановлен; данные для shadow">
      <bpmn:incoming>p1_tobe_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_tobe_F0" sourceRef="p1_tobe_start" targetRef="p1_tobe_scope"/>
    <bpmn:sequenceFlow id="p1_tobe_F1" sourceRef="p1_tobe_scope" targetRef="p1_tobe_build"/>
    <bpmn:sequenceFlow id="p1_tobe_F2" sourceRef="p1_tobe_build" targetRef="p1_tobe_registry"/>
    <bpmn:sequenceFlow id="p1_tobe_F3" sourceRef="p1_tobe_registry" targetRef="p1_tobe_complete"/>
    <bpmn:sequenceFlow id="p1_tobe_F4" sourceRef="p1_tobe_complete" targetRef="p1_tobe_block" name="Нет"/>
    <bpmn:sequenceFlow id="p1_tobe_F5" sourceRef="p1_tobe_block" targetRef="p1_tobe_endblock"/>
    <bpmn:sequenceFlow id="p1_tobe_F6" sourceRef="p1_tobe_complete" targetRef="p1_tobe_canary" name="Да"/>
    <bpmn:sequenceFlow id="p1_tobe_F7" sourceRef="p1_tobe_canary" targetRef="p1_tobe_failure"/>
    <bpmn:sequenceFlow id="p1_tobe_F8" sourceRef="p1_tobe_failure" targetRef="p1_tobe_accept" name="Нет"/>
    <bpmn:sequenceFlow id="p1_tobe_F9" sourceRef="p1_tobe_accept" targetRef="p1_tobe_endok"/>
    <bpmn:sequenceFlow id="p1_tobe_F10" sourceRef="p1_tobe_failure" targetRef="p1_tobe_manual" name="Да"/>
    <bpmn:sequenceFlow id="p1_tobe_F11" sourceRef="p1_tobe_manual" targetRef="p1_tobe_decision"/>
    <bpmn:sequenceFlow id="p1_tobe_F12" sourceRef="p1_tobe_decision" targetRef="p1_tobe_recover"/>
    <bpmn:sequenceFlow id="p1_tobe_F13" sourceRef="p1_tobe_recover" targetRef="p1_tobe_archive"/>
    <bpmn:sequenceFlow id="p1_tobe_F14" sourceRef="p1_tobe_archive" targetRef="p1_tobe_endbad"/>
  </bpmn:process>
