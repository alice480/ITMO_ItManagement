        <dc:Bounds x="1820" y="871.0" width="176" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_asis_endreject_di" bpmnElement="p2_asis_endreject" bioc:fill="#e5f3e8" bioc:stroke="#27753d">
