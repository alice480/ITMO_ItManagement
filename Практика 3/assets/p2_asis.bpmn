<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p2_asis_Definitions" targetNamespace="urn:lamoda:cto:scenario-review:2026">
  <bpmn:collaboration id="p2_asis_Collaboration">
    <bpmn:participant id="p2_asis_Pool" name="Lamoda" processRef="p2_asis_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="p2_asis_Process" name="P2 · AS-IS · Согласование до проверки заморозки и выхода" isExecutable="false">
    <bpmn:laneSet id="p2_asis_LaneSet">
      <bpmn:lane id="p2_asis_Lane0" name="FinOps / Finance">
        <bpmn:flowNodeRef>p2_asis_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_endok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_asis_Lane1" name="Агент / сбор данных">
        <bpmn:flowNodeRef>p2_asis_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_propose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_asis_Lane2" name="Service Owner / SRE">
        <bpmn:flowNodeRef>p2_asis_owner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_apply</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_asis_Lane3" name="Change Manager">
        <bpmn:flowNodeRef>p2_asis_freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_enddefer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_asis_Lane4" name="CRO / Exit Readiness">
        <bpmn:flowNodeRef>p2_asis_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_riskgate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_asis_endreject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_asis_start" name="Получена детализация">
      <bpmn:outgoing>p2_asis_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="p2_asis_data" name="P2.1 Свести потребление и стоимость">
      <bpmn:incoming>p2_asis_F0</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_asis_propose" name="P2.2 Предложить сокращение и новый тариф">
      <bpmn:incoming>p2_asis_F1</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p2_asis_owner" name="P2.3 Одобрить без окна и exit-проверки">
      <bpmn:incoming>p2_asis_F2</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p2_asis_freeze" name="P2.4 Проверить заморозку после одобрения">
      <bpmn:incoming>p2_asis_F3</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p2_asis_blocked" name="Изменение запрещено?">
      <bpmn:incoming>p2_asis_F4</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F5</bpmn:outgoing>
      <bpmn:outgoing>p2_asis_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_asis_defer" name="P2.5 Отложить или отменить изменение">
      <bpmn:incoming>p2_asis_F5</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_asis_enddefer" name="Экономия не получена">
      <bpmn:incoming>p2_asis_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_asis_risk" name="P2.6 Проверить обязательства по тарифу">
      <bpmn:incoming>p2_asis_F7</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p2_asis_riskgate" name="Выход ухудшается?">
      <bpmn:incoming>p2_asis_F8</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F9</bpmn:outgoing>
      <bpmn:outgoing>p2_asis_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_asis_reject" name="P2.7 Отклонить неподходящий тариф">
      <bpmn:incoming>p2_asis_F9</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_asis_endreject" name="Тариф не принят">
      <bpmn:incoming>p2_asis_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_asis_apply" name="P2.8 Исполнить доступное изменение">
      <bpmn:incoming>p2_asis_F11</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p2_asis_verify" name="P2.9 Подтвердить эффект по счетам">
      <bpmn:incoming>p2_asis_F12</bpmn:incoming>
      <bpmn:outgoing>p2_asis_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_asis_endok" name="Эффект подтверждён">
      <bpmn:incoming>p2_asis_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p2_asis_F0" sourceRef="p2_asis_start" targetRef="p2_asis_data"/>
    <bpmn:sequenceFlow id="p2_asis_F1" sourceRef="p2_asis_data" targetRef="p2_asis_propose"/>
    <bpmn:sequenceFlow id="p2_asis_F2" sourceRef="p2_asis_propose" targetRef="p2_asis_owner"/>
    <bpmn:sequenceFlow id="p2_asis_F3" sourceRef="p2_asis_owner" targetRef="p2_asis_freeze"/>
    <bpmn:sequenceFlow id="p2_asis_F4" sourceRef="p2_asis_freeze" targetRef="p2_asis_blocked"/>
    <bpmn:sequenceFlow id="p2_asis_F5" sourceRef="p2_asis_blocked" targetRef="p2_asis_defer" name="Да"/>
    <bpmn:sequenceFlow id="p2_asis_F6" sourceRef="p2_asis_defer" targetRef="p2_asis_enddefer"/>
    <bpmn:sequenceFlow id="p2_asis_F7" sourceRef="p2_asis_blocked" targetRef="p2_asis_risk" name="Нет"/>
    <bpmn:sequenceFlow id="p2_asis_F8" sourceRef="p2_asis_risk" targetRef="p2_asis_riskgate"/>
    <bpmn:sequenceFlow id="p2_asis_F9" sourceRef="p2_asis_riskgate" targetRef="p2_asis_reject" name="Да"/>
    <bpmn:sequenceFlow id="p2_asis_F10" sourceRef="p2_asis_reject" targetRef="p2_asis_endreject"/>
    <bpmn:sequenceFlow id="p2_asis_F11" sourceRef="p2_asis_riskgate" targetRef="p2_asis_apply" name="Нет"/>
    <bpmn:sequenceFlow id="p2_asis_F12" sourceRef="p2_asis_apply" targetRef="p2_asis_verify"/>
    <bpmn:sequenceFlow id="p2_asis_F13" sourceRef="p2_asis_verify" targetRef="p2_asis_endok"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p2_asis_Diagram">
    <bpmndi:BPMNPlane id="p2_asis_Plane" bpmnElement="p2_asis_Collaboration">
      <bpmndi:BPMNShape id="p2_asis_Pool_di" bpmnElement="p2_asis_Pool" isHorizontal="true">
        <dc:Bounds x="20" y="120" width="2398" height="880"/>
