<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p1_asis_Definitions" targetNamespace="urn:lamoda:cto:scenario-review:2026">
  <bpmn:collaboration id="p1_asis_Collaboration">
    <bpmn:participant id="p1_asis_Pool" name="Lamoda" processRef="p1_asis_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="p1_asis_Process" name="P1 · AS-IS · Выпуск и разбор canary-инцидента" isExecutable="false">
    <bpmn:laneSet id="p1_asis_LaneSet">
      <bpmn:lane id="p1_asis_Lane0" name="Продукт / Release owner">
        <bpmn:flowNodeRef>p1_asis_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_endok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_asis_Lane1" name="Разработка / QA / CI">
        <bpmn:flowNodeRef>p1_asis_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_logs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_asis_Lane2" name="Агент сопровождения">
        <bpmn:flowNodeRef>p1_asis_draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_asis_Lane3" name="SRE / дежурный инженер">
        <bpmn:flowNodeRef>p1_asis_canary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_asis_endbad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_asis_Lane4" name="Incident Commander / Operations">
        <bpmn:flowNodeRef>p1_asis_decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_asis_start" name="Изменение готово">
      <bpmn:outgoing>p1_asis_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p1_asis_scope" name="P1.1 Согласовать объём и условия выпуска">
      <bpmn:incoming>p1_asis_F0</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_asis_build" name="P1.2 Реализовать и проверить изменение">
      <bpmn:incoming>p1_asis_F1</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_asis_logs" name="P1.3 Записать релизы в несвязанные журналы">
      <bpmn:incoming>p1_asis_F2</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_asis_canary" name="P1.4 Выпустить и наблюдать canary">
      <bpmn:incoming>p1_asis_F3</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p1_asis_failure" name="Есть инцидент?">
      <bpmn:incoming>p1_asis_F4</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F5</bpmn:outgoing>
      <bpmn:outgoing>p1_asis_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_asis_accept" name="P1.5 Принять новый маршрут заказов">
      <bpmn:incoming>p1_asis_F5</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_asis_endok" name="Маршрут принят">
      <bpmn:incoming>p1_asis_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p1_asis_draft" name="P1.6 Назвать релиз по неполному контексту">
      <bpmn:incoming>p1_asis_F7</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p1_asis_review" name="P1.7 Проверить и исправить черновик">
      <bpmn:incoming>p1_asis_F8</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p1_asis_correct" name="Привязка верна?">
      <bpmn:incoming>p1_asis_F9</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F10</bpmn:outgoing>
      <bpmn:outgoing>p1_asis_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_asis_manual" name="P1.8 Установить релиз и причину вручную">
      <bpmn:incoming>p1_asis_F10</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_asis_decision" name="P1.9 Выбрать безопасное восстановление">
      <bpmn:incoming>p1_asis_F11</bpmn:incoming>
      <bpmn:incoming>p1_asis_F12</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p1_asis_recover" name="P1.10 Восстановить и сверить заказы">
      <bpmn:incoming>p1_asis_F13</bpmn:incoming>
      <bpmn:outgoing>p1_asis_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_asis_endbad" name="Сервис восстановлен; canary остановлен">
      <bpmn:incoming>p1_asis_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_asis_F0" sourceRef="p1_asis_start" targetRef="p1_asis_scope"/>
    <bpmn:sequenceFlow id="p1_asis_F1" sourceRef="p1_asis_scope" targetRef="p1_asis_build"/>
    <bpmn:sequenceFlow id="p1_asis_F2" sourceRef="p1_asis_build" targetRef="p1_asis_logs"/>
    <bpmn:sequenceFlow id="p1_asis_F3" sourceRef="p1_asis_logs" targetRef="p1_asis_canary"/>
    <bpmn:sequenceFlow id="p1_asis_F4" sourceRef="p1_asis_canary" targetRef="p1_asis_failure"/>
    <bpmn:sequenceFlow id="p1_asis_F5" sourceRef="p1_asis_failure" targetRef="p1_asis_accept" name="Нет"/>
    <bpmn:sequenceFlow id="p1_asis_F6" sourceRef="p1_asis_accept" targetRef="p1_asis_endok"/>
    <bpmn:sequenceFlow id="p1_asis_F7" sourceRef="p1_asis_failure" targetRef="p1_asis_draft" name="Да"/>
    <bpmn:sequenceFlow id="p1_asis_F8" sourceRef="p1_asis_draft" targetRef="p1_asis_review"/>
    <bpmn:sequenceFlow id="p1_asis_F9" sourceRef="p1_asis_review" targetRef="p1_asis_correct"/>
    <bpmn:sequenceFlow id="p1_asis_F10" sourceRef="p1_asis_correct" targetRef="p1_asis_manual" name="Нет"/>
    <bpmn:sequenceFlow id="p1_asis_F11" sourceRef="p1_asis_manual" targetRef="p1_asis_decision"/>
    <bpmn:sequenceFlow id="p1_asis_F12" sourceRef="p1_asis_correct" targetRef="p1_asis_decision" name="Да"/>
    <bpmn:sequenceFlow id="p1_asis_F13" sourceRef="p1_asis_decision" targetRef="p1_asis_recover"/>
    <bpmn:sequenceFlow id="p1_asis_F14" sourceRef="p1_asis_recover" targetRef="p1_asis_endbad"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p1_asis_Diagram">
    <bpmndi:BPMNPlane id="p1_asis_Plane" bpmnElement="p1_asis_Collaboration">
