<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="p2_tobe_Definitions" targetNamespace="urn:lamoda:cto:scenario-review:2026">
  <bpmn:collaboration id="p2_tobe_Collaboration">
    <bpmn:participant id="p2_tobe_Pool" name="Lamoda" processRef="p2_tobe_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="p2_tobe_Process" name="P2 · TO-BE · Допуск по мощности, календарю и стоимости выхода" isExecutable="false">
    <bpmn:laneSet id="p2_tobe_LaneSet">
      <bpmn:lane id="p2_tobe_Lane0" name="FinOps / Finance">
        <bpmn:flowNodeRef>p2_tobe_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_endok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_tobe_Lane1" name="Агент / сбор данных">
        <bpmn:flowNodeRef>p2_tobe_data</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_tobe_Lane2" name="Service Owner / SRE">
        <bpmn:flowNodeRef>p2_tobe_capacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_capgate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_apply</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_tobe_Lane3" name="Change Manager">
        <bpmn:flowNodeRef>p2_tobe_freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_frozen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_enddefer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_endinvalid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_tobe_Lane4" name="CRO / Exit Readiness">
        <bpmn:flowNodeRef>p2_tobe_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_riskgate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_tobe_endreject</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_tobe_start" name="Новая или отложенная рекомендация">
      <bpmn:outgoing>p2_tobe_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="p2_tobe_data" name="P2.N1 Собрать ресурсы, окно, тариф и нагрузку">
      <bpmn:incoming>p2_tobe_F0</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_tobe_freeze" name="P2.N2 Проверить допустимость до согласования">
      <bpmn:incoming>p2_tobe_F1</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_tobe_frozen" name="Окно закрыто?">
      <bpmn:incoming>p2_tobe_F2</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F3</bpmn:outgoing>
      <bpmn:outgoing>p2_tobe_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_tobe_defer" name="P2.5 Зафиксировать отсрочку; эффект не признавать">
      <bpmn:incoming>p2_tobe_F3</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_tobe_enddefer" name="Ожидать открытия окна; повторить проверку">
      <bpmn:incoming>p2_tobe_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_tobe_capacity" name="P2.N3 Подтвердить запас мощности и откат">
      <bpmn:incoming>p2_tobe_F5</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p2_tobe_capgate" name="Мощность достаточна?">
      <bpmn:incoming>p2_tobe_F6</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F7</bpmn:outgoing>
      <bpmn:outgoing>p2_tobe_F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_tobe_risk" name="P2.N4 Рассчитать обязательства и exit cost">
      <bpmn:incoming>p2_tobe_F7</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p2_tobe_riskgate" name="Лимит выхода соблюдён?">
      <bpmn:incoming>p2_tobe_F8</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F9</bpmn:outgoing>
      <bpmn:outgoing>p2_tobe_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_tobe_reject" name="P2.7 Отклонить; сохранить доказательства">
      <bpmn:incoming>p2_tobe_F9</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F10</bpmn:outgoing>
      <bpmn:incoming>p2_tobe_F19</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_tobe_endreject" name="Изменение отклонено">
      <bpmn:incoming>p2_tobe_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_tobe_approve" name="P2.N5 Согласовать чистый эффект и дату">
      <bpmn:incoming>p2_tobe_F11</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p2_tobe_recheck" name="P2.N6 Повторно проверить окно и версию пакета">
      <bpmn:incoming>p2_tobe_F12</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_tobe_valid" name="Допуск актуален?">
      <bpmn:incoming>p2_tobe_F13</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F14</bpmn:outgoing>
      <bpmn:outgoing>p2_tobe_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_tobe_invalid" name="P2.N7 Вернуть на пересмотр; ничего не менять">
      <bpmn:incoming>p2_tobe_F14</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_tobe_endinvalid" name="Новая итерация допуска">
      <bpmn:incoming>p2_tobe_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_tobe_apply" name="P2.8 Применить, наблюдать; при сбое откатить">
      <bpmn:incoming>p2_tobe_F16</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p2_tobe_verify" name="P2.9 Сверить счета, SLO и чистый эффект">
      <bpmn:incoming>p2_tobe_F17</bpmn:incoming>
      <bpmn:outgoing>p2_tobe_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_tobe_endok" name="Результат принят Finance и SRE">
      <bpmn:incoming>p2_tobe_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p2_tobe_F0" sourceRef="p2_tobe_start" targetRef="p2_tobe_data"/>
    <bpmn:sequenceFlow id="p2_tobe_F1" sourceRef="p2_tobe_data" targetRef="p2_tobe_freeze"/>
    <bpmn:sequenceFlow id="p2_tobe_F2" sourceRef="p2_tobe_freeze" targetRef="p2_tobe_frozen"/>
    <bpmn:sequenceFlow id="p2_tobe_F3" sourceRef="p2_tobe_frozen" targetRef="p2_tobe_defer" name="Да"/>
    <bpmn:sequenceFlow id="p2_tobe_F4" sourceRef="p2_tobe_defer" targetRef="p2_tobe_enddefer"/>
    <bpmn:sequenceFlow id="p2_tobe_F5" sourceRef="p2_tobe_frozen" targetRef="p2_tobe_capacity" name="Нет"/>
    <bpmn:sequenceFlow id="p2_tobe_F6" sourceRef="p2_tobe_capacity" targetRef="p2_tobe_capgate"/>
    <bpmn:sequenceFlow id="p2_tobe_F7" sourceRef="p2_tobe_capgate" targetRef="p2_tobe_risk" name="Да"/>
    <bpmn:sequenceFlow id="p2_tobe_F8" sourceRef="p2_tobe_risk" targetRef="p2_tobe_riskgate"/>
    <bpmn:sequenceFlow id="p2_tobe_F9" sourceRef="p2_tobe_riskgate" targetRef="p2_tobe_reject" name="Нет"/>
    <bpmn:sequenceFlow id="p2_tobe_F10" sourceRef="p2_tobe_reject" targetRef="p2_tobe_endreject"/>
    <bpmn:sequenceFlow id="p2_tobe_F11" sourceRef="p2_tobe_riskgate" targetRef="p2_tobe_approve" name="Да"/>
    <bpmn:sequenceFlow id="p2_tobe_F12" sourceRef="p2_tobe_approve" targetRef="p2_tobe_recheck"/>
    <bpmn:sequenceFlow id="p2_tobe_F13" sourceRef="p2_tobe_recheck" targetRef="p2_tobe_valid"/>
    <bpmn:sequenceFlow id="p2_tobe_F14" sourceRef="p2_tobe_valid" targetRef="p2_tobe_invalid" name="Нет"/>
    <bpmn:sequenceFlow id="p2_tobe_F15" sourceRef="p2_tobe_invalid" targetRef="p2_tobe_endinvalid"/>
    <bpmn:sequenceFlow id="p2_tobe_F16" sourceRef="p2_tobe_valid" targetRef="p2_tobe_apply" name="Да"/>
    <bpmn:sequenceFlow id="p2_tobe_F17" sourceRef="p2_tobe_apply" targetRef="p2_tobe_verify"/>
    <bpmn:sequenceFlow id="p2_tobe_F18" sourceRef="p2_tobe_verify" targetRef="p2_tobe_endok"/>
    <bpmn:sequenceFlow id="p2_tobe_F19" sourceRef="p2_tobe_capgate" targetRef="p2_tobe_reject" name="Нет"/>
  </bpmn:process>
